#include <iostream>

using namespace std;

int main() {
    int startValue, endValue;
    
    if (!(cin >> startValue >> endValue)) {
        return 0;
    }
   
    for (int i = startValue; i <= endValue; i++) {
        if (i <= 1) {
            continue; 
        }
        
        bool isPrime = true;
        
  
        for (int j = 2; j * j <= i; j++) {
            if (i % j == 0) {
                isPrime = false;
                break;
            }
        }
        
        if (isPrime) {
            cout << i << endl;
        }
    }
    
    return 0;
}

